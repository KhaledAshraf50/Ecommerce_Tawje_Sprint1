<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Welcome to ECommerce Tawj</title>
</head>
<body style="margin:0; padding:0; background-color:#f5f5f5; font-family:Arial, sans-serif;">
<div class="container my-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-5 rounded-4 bg-white">
        <div class="mb-3">
            <i class="fa-solid fa-circle-check display-1 text-success"></i>
        </div>
            <h2 class="fw-bold text-dark">Thank You, [UserName]</h2>
        <p class="text-muted">Your order has been placed successfully.</p>

        <div class="bg-light p-3 rounded-3 my-3 text-start">
                <p class="mb-1"><strong>Order ID:</strong> #[OrderID]</p>
                <p class="mb-1"><strong>Payment Method:</strong> [PaymentMethod]</p>
                <p class="mb-1"><strong>Shipping Address:</strong>[ShippingAddress]</p>
                <p class="mb-1"><strong>Order Date:</strong>[OrderDate]</p>
                <p class="mb-0"><strong>Total Amount:</strong>[TotalAmount]</p>
        </div>
    </div>
</div>
</body>
</html>