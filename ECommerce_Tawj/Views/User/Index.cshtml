@using ECommerce_Tawj.DTOs.UserDTOs
@model UserListDTO
@{

    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";
}
@section Styles{
    <link href="~/css/Users.css" rel="stylesheet" />
}
<main class="flex-grow-1 p-4 p-md-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0">Users Management</h4>

        <!-- Search Box (Sprint Challenge) -->
        <form asp-controller="User" asp-action="Index" method="get" class="d-inline">
            <div class="input-group style-search" style="max-width: 300px">
                <span class="input-group-text bg-white border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control border-start-0"
                       placeholder="Search user or email..."
                       onchange="this.form.submit()"/>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="table-responsive user-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>User Details</th>
                    <th>Role</th>
                    <th>Lock Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if(Model.Users != null && Model.Users.Any())
                {
                    @foreach(var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <div class="text-muted small">@user.Email</div>
                                </div>
                            </td>
                            <td>
                                @if(user.Role == "Admin")
                                {
                                    <span class="badge badge-role-admin px-3 py-2 rounded-pill">Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-role-customer px-3 py-2 rounded-pill">Customer</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="badge badge-status-locked px-3 py-2 rounded-pill">Locked</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-active px-3 py-2 rounded-pill">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline">
                                    <form asp-controller="User" asp-action="ToggleRole" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                        @if (user.Role == "Admin")
                                        {
                                            <button type="submit" class="btn btn-outline-warning btn-action btn-sm">
                                                Demote to Customer
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-primary btn-action btn-sm">
                                                Promote to Admin
                                            </button>
                                        }
                                    </form>
                                    <form asp-controller="User" asp-action="ToggleLock" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

                                        @if (user.IsLocked)
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-action btn-sm">
                                                Unlock Account
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-action btn-sm">
                                                Lock Account
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            No users found matching your search.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if(Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-end mt-4">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled": "")">
                    <a class="page-link"
                    asp-controller="User"
                    asp-action="Index"
                    asp-route-searchTerm="@Model.SearchTerm"
                    asp-route-pageNumber="@(Model.PageNumber-1)">Previous</a>
                </li>
                @for(int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active":"")">
                        <a class="page-link @(i == Model.PageNumber ? "bg-secondary border-secondary" : "text-dark") "
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }

</main>