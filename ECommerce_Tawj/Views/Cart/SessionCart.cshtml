@model List<SessionCartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_Layout";
}

<section class="container my-5">

    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">

        <div>

            <h2 class="fw-bold text-dark m-0">
                <i class="fa-solid fa-cart-shopping me-2"
                   style="color:#ff5722;"></i>

                My Shopping Cart
            </h2>

            <p class="text-muted small mb-0 mt-1">
                Review your items before proceeding to checkout
            </p>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3 btn-sm">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Continue Shopping

        </a>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            <!-- Cart Items -->
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4">

                    <div class="table-responsive">

                        <table class="table align-middle border-0 mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th class="text-end">Action</th>
                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- Product -->
                                        <td>

                                            <div class="d-flex align-items-center gap-3">

                                                <img src="@item.ImageUrl"
                                                     class="rounded-3"
                                                     style="width:65px;
                                                height:65px;
                                                object-fit:contain;
                                                background:#f8f9fa;
                                                padding:5px;"
                                                     alt="@item.ProductName" />

                                                <div>

                                                    <h6 class="fw-bold text-dark mb-0">
                                                        @item.ProductName
                                                    </h6>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- Price -->
                                        <td class="fw-semibold text-dark">

                                            $@item.Price.ToString("F2")

                                        </td>


                                        <!-- Quantity -->
                                        <td>

                                            <div class="d-flex align-items-center gap-2">

                                                <!-- Decrease -->
                                                <form asp-controller="Cart"
                                                      asp-action="DecreaseQuantity"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@item.ProductId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">

                                                        <i class="fa-solid fa-minus"></i>

                                                    </button>

                                                </form>


                                                <!-- Quantity -->
                                                <span class="fw-bold"
                                                      style="min-width:30px;
                                                    text-align:center;">

                                                    @item.Quantity

                                                </span>


                                                <!-- Increase -->
                                                <form asp-controller="Cart"
                                                      asp-action="IncreaseQuantity"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@item.ProductId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">

                                                        <i class="fa-solid fa-plus"></i>

                                                    </button>

                                                </form>

                                            </div>

                                        </td>


                                        <!-- Total -->
                                        <td class="fw-bold text-dark">

                                            $@((item.Price * item.Quantity).ToString("F2"))

                                        </td>


                                        <!-- Remove -->
                                        <td class="text-end">

                                            <form asp-controller="Cart"
                                                  asp-action="Remove"
                                                  method="post">

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-circle p-2"
                                                        title="Remove Item">

                                                    <i class="fa-solid fa-trash-can"></i>

                                                </button>

                                            </form>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- Order Summary -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">

                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        Order Summary
                    </h5>


                    <!-- Items Count -->
                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Items
                        </span>

                        <span class="fw-bold">
                            @Model.Sum(x => x.Quantity)
                        </span>

                    </div>


                    <!-- Subtotal -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <span class="fw-bold text-dark">

                            $@Model.Sum(x => x.Price * x.Quantity).ToString("F2")

                        </span>

                    </div>


                    <hr />


                    <!-- Total -->
                    <div class="d-flex justify-content-between mb-4">

                        <span class="fw-bold fs-5">
                            Total
                        </span>

                        <span class="fw-bold fs-4"
                              style="color:#ff5722;">

                            $@Model.Sum(x => x.Price * x.Quantity).ToString("F2")

                        </span>

                    </div>


                    <!-- Clear Cart -->
                    <form asp-controller="Cart"
                          asp-action="Clear"
                          method="post"
                          class="mb-2">

                        <button type="submit"
                                class="btn btn-outline-danger w-100">

                            <i class="fa-solid fa-trash me-2"></i>

                            Clear Cart

                        </button>

                    </form>


                    <!-- Checkout -->
                    <a asp-action="CheckOut"
                       asp-controller="Order"
                       class="btn w-100 py-2 rounded-3 text-white fw-bold shadow-sm"
                       style="background-color:#ff5722;">

                        Proceed to Checkout

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Empty Cart -->

        <div class="text-center py-5 my-5">

            <div class="mb-3">

                <i class="fa-solid fa-basket-shopping display-1 text-muted opacity-50"></i>

            </div>


            <h4 class="fw-bold text-dark">
                Your Cart is Currently Empty
            </h4>


            <p class="text-muted small mb-4">
                Looks like you haven't added anything to your cart yet.
            </p>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn text-white px-4 py-2 rounded-3 fw-semibold"
               style="background-color:#ff5722;">

                Start Shopping Now

            </a>

        </div>
    }

</section>