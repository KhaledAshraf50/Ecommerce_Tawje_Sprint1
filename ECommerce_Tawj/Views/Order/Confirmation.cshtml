@using ECommerce_Tawj.Models
@model Order

@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_Layout";
}

<div class="container my-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-5 rounded-4 bg-white">
        <div class="mb-3">
            <i class="fa-solid fa-circle-check display-1 text-success"></i>
        </div>
        <h2 class="fw-bold text-dark">Thank You, @Model.ShippingFirstName!</h2>
        <p class="text-muted">Your order has been placed successfully.</p>

        <div class="bg-light p-3 rounded-3 my-3 text-start">
            <p class="mb-1"><strong>Order ID:</strong> #@Model.Id</p>
            <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
            <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
            <p class="mb-1"><strong>Shipping Address:</strong> @Model.ShippingAddress, @Model.ShippingCity</p>
            <p class="mb-0"><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("F2")</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn text-white py-2.5 rounded-3 fw-bold mt-2" style="background-color: #ff5722;">
            Continue Shopping
        </a>
    </div>
</div>