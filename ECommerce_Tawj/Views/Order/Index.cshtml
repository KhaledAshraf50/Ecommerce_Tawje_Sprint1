@using ECommerce_Tawj.DTOs.OrdersDTOs
@model IEnumerable<AdminOrderDTO>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Order List";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Orders.css" />
}

<main class="flex-grow-1 p-4 p-md-5" style="max-width: 1000px">
    <h4 class="fw-bold text-dark mb-4">Orders</h4>

    <div class="orders-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var order in Model)
            {
                <div class="order-card d-flex gap-3 align-items-start mb-3">
                    <div class="order-icon-box">
                        <i class="fa-solid fa-box"></i>
                    </div>

                    <div class="row w-100 g-3">
                        <!-- Items Details -->
                        <div class="col-md-4">
                            <p class="fw-bold text-dark mb-1 small">
                                @order.ItemsSummary
                            </p>
                            <span class="text-muted small">Items : @order.ItemsCount</span>
                        </div>

                        <!-- Customer Details -->
                        <div class="col-md-3">
                            <p class="fw-bold text-dark mb-0 small">@order.CustomerName</p>
                            <p class="text-muted mb-0 small">@order.ShippingAddress</p>
                            <p class="text-muted mb-0 small">@order.ShippingCity</p>
                            <p class="text-muted mb-0 small">@order.ShippingPhone</p>
                        </div>

                        <!-- Total Price -->
                        <div class="col-md-2 text-md-center">
                            <span class="fw-bold text-dark">$@order.TotalAmount.ToString("F2")</span>
                        </div>

                        <!-- Payment Info -->
                        <div class="col-md-3">
                            <p class="text-muted mb-0 small">Method : @order.PaymentMethod</p>
                            <p class="text-muted mb-0 small">Date : @order.OrderDate.ToString("M/d/yyyy")</p>
                            <p class="text-muted mb-0 small">Payment : @order.Status</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-3 border">
                <i class="fa-solid fa-box-open display-4 text-muted mb-3"></i>
                <p class="text-muted fw-bold">No orders found.</p>
            </div>
        }
    </div>
</main>