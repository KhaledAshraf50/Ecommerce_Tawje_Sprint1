@using ECommerce_Tawj.DTOs.OrdersDTOs
@using ECommerce_Tawj.Models
@model CheckoutDTO

@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
}

@section Styles {
    <style>
        :root {
            --primary-orange: #f05423;
        }

        body {
            background-color: #f8f9fa;
        }

        .btn-orange {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            font-weight: 600;
        }

            .btn-orange:hover {
                background-color: #d84315;
                color: white;
            }
    </style>
}

<div class="container my-5" style="max-width: 1000px">
    <h3 class="fw-bold mb-4">Checkout</h3>

    <form asp-controller="Order" asp-action="ProcessCheckout" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Shipping Information Form -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                    <h5 class="fw-bold mb-3">Shipping Address</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">First Name</label>
                            <input asp-for="ShippingFirstName" class="form-control" placeholder="John" />
                            <span asp-validation-for="ShippingFirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Last Name</label>
                            <input asp-for="ShippingLastName" class="form-control" placeholder="Doe" />
                            <span asp-validation-for="ShippingLastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-secondary small fw-bold">Street Address</label>
                            <input asp-for="ShippingAddress" class="form-control" placeholder="123 Main St" />
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">City</label>
                            <input asp-for="ShippingCity" class="form-control" placeholder="New York" />
                            <span asp-validation-for="ShippingCity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Phone Number</label>
                            <input asp-for="ShippingPhone" class="form-control" placeholder="01012345678" />
                            <span asp-validation-for="ShippingPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold mt-4 mb-3">Payment Method</h5>

                    <div class="form-check p-3 border rounded-3 mb-2">
                        <input class="form-check-input ms-1 me-2" type="radio" asp-for="PaymentMethod" value="@PaymentMethods.COD.ToString()" id="cod" checked />
                        <label class="form-check-label fw-medium" for="cod">
                            <i class="fa-solid fa-money-bill-wave text-success me-2"></i> Cash on Delivery (COD)
                        </label>
                    </div>

                    <div class="form-check p-3 border rounded-3">
                        <input class="form-check-input ms-1 me-2" type="radio" asp-for="PaymentMethod" value="@PaymentMethods.Card.ToString()" id="card" />
                        <label class="form-check-label fw-medium" for="card">
                            <i class="fa-solid fa-credit-card text-primary me-2"></i> Credit / Debit Card (Stripe)
                        </label>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    @if (Model.Cart != null && Model.Cart.Items.Any())
                    {
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@item.MainImage" style="width: 45px; height: 45px; object-fit: contain;" class="rounded border p-1" />
                                    <div>
                                        <h6 class="fw-bold mb-0 text-truncate" style="max-width: 150px;">@item.ProductName</h6>
                                        <small class="text-muted">Qty: @item.Quantity</small>
                                    </div>
                                </div>
                                <span class="fw-bold">$@item.TotalPrice.ToString("F2")</span>
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-between text-muted mb-2">
                            <span>Subtotal</span>
                            <span>$@Model.Cart.SubTotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted mb-2">
                            <span>Shipping</span>
                            <span>$@Model.Cart.ShippingFee.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-dark fs-5 mt-3">
                            <span>Total</span>
                            <span style="color: #ff5722;">$@Model.Cart.GrandTotal.ToString("F2")</span>
                        </div>

                        <button type="submit" class="btn btn-orange w-100 py-3 rounded-3 mt-4">
                            Place Order
                        </button>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}