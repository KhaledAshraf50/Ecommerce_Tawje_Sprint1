@{
    Layout = "_Layout";
    ViewData["Title"] = "Page Not Found - 404";
}

@section Styles {
    <style>
        :root {
            --primary-orange: #f05423;
            --primary-orange-hover: #d84315;
        }

        .error-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 50px 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border: 1px solid #eaeaea;
            max-width: 600px;
            margin: 0 auto;
        }

        .error-code {
            font-size: 6rem;
            font-weight: 900;
            color: var(--primary-orange);
            line-height: 1;
        }

        .btn-orange {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }

        .btn-orange:hover {
            background-color: var(--primary-orange-hover);
            color: white;
        }
    </style>
}

<section class="container my-5 text-center">
    <div class="error-card">
        <div class="mb-3">
            <i class="fa-solid fa-compass-drafting text-secondary opacity-50" style="font-size: 4rem;"></i>
        </div>
        <h1 class="error-code mb-2">404</h1>
        <h3 class="fw-bold text-dark mb-3">الصفحة غير موجودة</h3>
        <p class="text-secondary mb-4">
            الصفحة التي تحاول الوصول إليها قد تكون حذفت تغير عنوانها أو أنها غير متاحة حالياً
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Home" asp-action="Index" class="btn btn-orange rounded-pill px-4 py-2 fs-6">
                <i class="fa-solid fa-house me-2"></i> الصفحة الرئيسية
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2 fs-6">
                <i class="fa-solid fa-arrow-right me-2"></i> العودة للخلف
            </button>
        </div>
    </div>
</section>