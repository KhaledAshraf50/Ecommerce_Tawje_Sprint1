@using ECommerce_Tawj.ViewModels.ProductsVM
@model List<ProductDTO>
@{

    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";
}
@section Styles{
    <link rel="stylesheet" href="~/css/productList.css" />
}
<main class="flex-grow-1 p-4 p-md-5" style="max-width: 1000px">
    <h4 class="fw-bold text-dark mb-4">All Product</h4>

    <div class="table-responsive product-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 40%">Product</th>
                    <th scope="col">Category</th>
                    <th scope="col">Price</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var pro in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="product-img-box">
                                    <img src="@pro.MainImage" alt="@pro.ProductName" />
                                </div>
                                <span class="fw-medium text-dark">@pro.ProductDescription</span>
                            </div>
                        </td>
                        <td>@pro.CategoryName</td>
                        <td class="fw-medium text-dark">$@pro.ProductPrice</td>
                        <td>
                            <a asp-controller="product" asp-action="ProductDetails" asp-route-productId="@pro.Id" class="btn-visit">
                                Visit
                                <i class="fa-solid fa-arrow-up-right-from-square fs-6"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>