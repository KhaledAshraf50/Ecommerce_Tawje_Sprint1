@using ECommerce_Tawj.DTOs.ProductsDTOs
@model CreateProductDTO
@{

    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";
}
@section Styles{
    <link rel="stylesheet" href="~/css/addProduct.css" />
}
<main class="flex-grow-1 p-4 p-md-5" style="max-width: 900px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="Create" method="post" asp-controller="Product" enctype="multipart/form-data" id="addProductForm">
        <!-- Product Image Upload -->
        <div class="mb-4">
            <label class="form-label fw-bold text-secondary mb-3">Product Image</label>
            <div class="d-flex gap-3">
                @for (int i = 0; i < 4; i++) 
                {
                    <label class="upload-box d-flex flex-column align-items-center justify-content-center" style="cursor:pointer;">
                        
                        <img src="#" alt="Preview" class="d-none" />

                        <div class="dz-message d-flex flex-column align-items-center justify-content-center">
                            <i class="fa-solid fa-cloud-arrow-up fs-4 mb-1"></i>
                            <span class="small">Upload</span>
                        </div>

                        <input type="file" name="Images" hidden accept="image/*" class="image-input" />
                    </label>
                    <span asp-validation-for="Images" class="text-danger"></span>
                }
            </div>
        </div>

        <!-- Product Name -->
        <div class="mb-4">
            <label class="form-label fw-bold text-secondary">Product Name</label>
            <input type="text" asp-for="Name" class="form-control" placeholder="Type here" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Product Description -->
        <div class="mb-4">
            <label class="form-label fw-bold text-secondary">Product Description</label>
            <textarea class="form-control" asp-for="Description"
                      rows="5"
                      placeholder="Type here"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>

        </div>

        <!-- Row for Category, Price, and Offer Price -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Choose Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Product Price</label>
                <input type="number" asp-for="Price" class="form-control" value="0" />
                <span asp-validation-for="Price" class="text-danger"></span>    
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Discount Percentage (0-100)</label>
                <input type="number" asp-for="DiscountPercentage" class="form-control" value="0" />
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-add mt-2">ADD</button>
    </form>
</main>
@section Scripts{
    <script>
        document.querySelectorAll('.image-input').forEach(input=>{
            input.addEventListener('change',function(e){
                const file = this.files[0];
                const uploadBox = this.closest('.upload-box');
                const previewImg = uploadBox.querySelector('img');
                const dzMessage = uploadBox.querySelector('.dz-message');
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        previewImg.src = event.target.result;
                        previewImg.classList.remove('d-none'); // إظهار الصورة
                        dzMessage.classList.add('d-none'); // إخفاء الأيقونة والكلام
                    }
                    reader.readAsDataURL(file);
                }
                else{
                    // لو ألغى الاختيار، نرجع الشكل القديم
                    previewImg.src = "#";
                    previewImg.classList.add('d-none');
                    dzMessage.classList.remove('d-none');
                }
            });
        });
    </script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}