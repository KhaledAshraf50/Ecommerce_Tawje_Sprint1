@using ECommerce_Tawj.ViewModels.ProductsVM
@model List<ProductDTO>
@{
    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productList.css" />
}

<main class="flex-grow-1 p-4 p-md-5" style="max-width: 1000px">
    <h4 class="fw-bold text-dark mb-4">Deleted Products</h4>
    <a asp-controller="Product" asp-action="Index"
       style="text-decoration:none;padding:5px;border-radius:4px;">All Products</a>

    <div class="table-responsive product-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 40%">Product</th>
                    <th scope="col">Category</th>
                    <th scope="col">Price</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pro in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="product-img-box">
                                    <img src="@pro.MainImage" alt="@pro.ProductName" />
                                </div>
                                <span class="fw-medium desc text-dark">@pro.ProductDescription</span>
                            </div>
                        </td>
                        <td>@pro.CategoryName</td>
                        <td class="fw-medium text-dark">$@pro.ProductPrice</td>
                        <td class="text-end">
                            <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@pro.Id" class="btn btn-sm btn-outline-info me-1" title="Visit">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@pro.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-controller="Product" asp-action="RestoreProduct" asp-route-id="@pro.Id" method="post" class="d-inline delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.btn-delete').forEach(button => {
        button.addEventListener('click', function () {
        const form = this.closest('.delete-form');
        Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
        if (result.isConfirmed) {
        form.submit();
        }
        });
        });
        });
    </script>
}