@using ECommerce_Tawj.DTOs.ProductsDTOs
@model ShopDTO

@{
    ViewData["Title"] = "Shop All Products";
    Layout = "_Layout";
}

<div class="container py-5">
    <!-- Search & Filter Bar -->
    <div class="row g-3 align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark mb-0">Shop Our Products</h3>
        </div>
        <div class="col-md-6">
            <form asp-controller="Product" asp-action="AllProduct" method="get">
                <div class="input-group shadow-sm rounded-3">
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control border-end-0 py-2 ps-3"
                           placeholder="Search products..." />
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                    <button class="btn btn-white border border-start-0 text-muted" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Category Pills -->
    <div class="d-flex gap-2 overflow-auto pb-3 mb-4">
        <a asp-controller="Product"
           asp-action="AllProduct"
           asp-route-searchTerm="@Model.SearchTerm"
           class="btn rounded-pill px-4 btn-sm @(!Model.SelectedCategoryId.HasValue ? "btn-dark" : "btn-outline-secondary")">
            All
        </a>

        @foreach (var cat in Model.Categories)
        {
            <a asp-controller="Product"
               asp-action="AllProduct"
               asp-route-categoryId="@cat.Id"
               asp-route-searchTerm="@Model.SearchTerm"
               class="btn rounded-pill px-4 btn-sm @(Model.SelectedCategoryId == cat.Id ? "btn-dark" : "btn-outline-secondary")">
                @cat.Name
            </a>
        }
    </div>

    <!-- Product Grid -->
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <!-- Favorite Heart Button -->
                        <button class="btn btn-white rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-1 px-2 border-0 bg-white btn-favorite"
                                data-product-id="@product.Id">
                            <i class="@(product.IsFavorite ? "fa-solid text-danger" : "fa-regular text-secondary") fa-heart fs-5"></i>
                        </button>

                        <!-- Product Image -->
                        <div class="bg-light text-center p-4">
                            <img src="@product.ImageUrl" class="img-fluid rounded-3" style="max-height: 180px; object-fit: contain;" alt="@product.Name" />
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <div>
                                <span class="text-muted small">@product.CategoryName</span>
                                <h6 class="fw-bold text-dark mt-1 mb-2 text-truncate">@product.Name</h6>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <span class="fw-bold fs-5 text-dark">$@product.Price.ToString("F2")</span>

                                <!-- Add to Cart Form -->
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn text-white btn-sm px-3 rounded-3" style="background-color: #ff5722;">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Add
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Dynamic Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-center mt-5">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link @(i == Model.PageNumber ? "bg-dark border-dark" : "text-dark")"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="fa-solid fa-box-open display-1 text-muted mb-3 opacity-50"></i>
            <h5 class="fw-bold text-dark">No products found</h5>
            <p class="text-muted small mb-0">Try adjusting your search or category filters.</p>
        </div>
    }
</div>
@section Scripts{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function(){
            $(document).on('click','.btn-favorite',function(e){
                e.preventDefault();
                var buuton = $(this);
                var icon = buuton.find('i');
                var productId = buuton.data('product-id');

                $.ajax({
                    url:'/Favorite/ToggleFavorite',
                    type:'POST',
                    data:{productId:productId},
                    success:function(response){
                        if(response.success){
                            if(response.isFavorite){
                                icon.removeClass('fa-regular text-secondary').addClass('fa-solid text-danger');
                            }
                            else{
                                 icon.removeClass('fa-solid text-danger').addClass('fa-regular text-secondary');
                            }
                        }
                    },
                    error:function(xhr){
                        if(xhr.status == 401){
                            window.location.href = '/Account/Login'
                        }
                    }
                });
            });
        });
    </script>
}