@{
    Layout = "_Layout";
}
@section Styles{
    <style>
        .btn-orange {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            font-weight: 500;
        }

            .btn-orange:hover {
                background-color: var(--primary-hover);
                color: white;
            }

        .filter-card {
            border: none;
            border-radius: 12px;
        }

        .form-check-input:checked {
            background-color: var(--primary-orange);
            border-color: var(--primary-orange);
        }

        .product-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .product-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            }

        .product-img-holder {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            border-radius: 8px;
        }

            .product-img-holder img {
                max-height: 140px;
                max-width: 100%;
                object-fit: contain;
            }
    </style>
}
<main class="container my-4">

    <!-- Breadcrumb & Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0">Explore All Products</h4>
        </div>

        <!-- Mobile Filter Toggle Button -->
        <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterSidebar">
            <i class="fa-solid fa-filter me-1"></i> Filters
        </button>
    </div>

    <div class="row g-4">

        <!-- Left Sidebar: Filters -->
        <aside class="col-lg-3">
            <div class="collapse d-lg-block" id="filterSidebar">
                <div class="card filter-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Filters</h5>
                        <a href="#" class="text-danger small text-decoration-none fw-bold">Reset All</a>
                    </div>
                    <hr class="mt-1 mb-3">

                    <!-- 1. Search Filter -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark small">Search Product</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-start-0" placeholder="e.g. Camera...">
                        </div>
                    </div>

                    <!-- 2. Categories Filter -->
                    <div class="mb-4">
                        <h6 class="fw-semibold text-dark small mb-2">Category</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="catAll" checked>
                            <label class="form-check-label text-secondary small" for="catAll">All Categories</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="catEarphones">
                            <label class="form-check-label text-secondary small" for="catEarphones">Earphones (14)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="catCameras">
                            <label class="form-check-label text-secondary small" for="catCameras">Cameras (8)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="catLaptops">
                            <label class="form-check-label text-secondary small" for="catLaptops">Laptops (21)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="catAccessories">
                            <label class="form-check-label text-secondary small" for="catAccessories">Accessories (19)</label>
                        </div>
                    </div>

                    <!-- 3. Price Range Filter -->
                    <div class="mb-4">
                        <h6 class="fw-semibold text-dark small mb-2">Price Range</h6>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <input type="number" class="form-control form-control-sm" placeholder="Min $">
                            <span>-</span>
                            <input type="number" class="form-control form-control-sm" placeholder="Max $">
                        </div>
                        <button class="btn btn-sm btn-outline-secondary w-100">Apply Price</button>
                    </div>

                    <!-- 4. Rating Filter -->
                    <div class="mb-3">
                        <h6 class="fw-semibold text-dark small mb-2">Rating</h6>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="rating" id="rate4">
                            <label class="form-check-label text-warning small" for="rate4">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-regular fa-star"></i> <span class="text-secondary">& Up</span>
                            </label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="rating" id="rate3">
                            <label class="form-check-label text-warning small" for="rate3">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-regular fa-star"></i><i class="fa-regular fa-star"></i> <span class="text-secondary">& Up</span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>
        </aside>

        <!-- Right Content: Products Grid -->
        <section class="col-lg-9">

            <!-- Sorting Bar -->
            <div class="bg-white p-3 rounded-3 border d-flex justify-content-between align-items-center mb-4">
                <span class="text-muted small">Showing <strong>1-6</strong> of <strong>24</strong> Products</span>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Sort By:</label>
                    <select class="form-select form-select-sm border-0 bg-light" style="width: 160px;">
                        <option value="featured">Featured</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="newest">Newest Arrivals</option>
                    </select>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="row g-3">

                <!-- Product Item 1 -->
                <div class="col-6 col-md-4">
                    <div class="card product-card h-100 p-3 position-relative">
                        <button class="btn btn-white rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-1 px-2 border-0">
                            <i class="fa-regular fa-heart text-secondary"></i>
                        </button>
                        <div class="product-img-holder mb-3">
                            <img src="https://via.placeholder.com/150" alt="Apple AirPods">
                        </div>
                        <div class="d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small">Earphones</span>
                                <h6 class="fw-bold text-dark mt-1 mb-1">Apple AirPods Pro 2nd gen</h6>
                                <div class="text-warning small mb-2"><i class="fa-solid fa-star"></i> 4.8</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-dark fs-5">$399.99</span>
                                <button class="btn btn-orange btn-sm rounded-pill px-3"><i class="fa-solid fa-cart-plus me-1"></i> Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Item 2 -->
                <div class="col-6 col-md-4">
                    <div class="card product-card h-100 p-3 position-relative">
                        <button class="btn btn-white rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-1 px-2 border-0">
                            <i class="fa-regular fa-heart text-secondary"></i>
                        </button>
                        <div class="product-img-holder mb-3">
                            <img src="https://via.placeholder.com/150" alt="Canon EOS R5">
                        </div>
                        <div class="d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small">Camera</span>
                                <h6 class="fw-bold text-dark mt-1 mb-1">Canon EOS R5</h6>
                                <div class="text-warning small mb-2"><i class="fa-solid fa-star"></i> 4.9</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-dark fs-5">$3899.99</span>
                                <button class="btn btn-orange btn-sm rounded-pill px-3"><i class="fa-solid fa-cart-plus me-1"></i> Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Item 3 -->
                <div class="col-6 col-md-4">
                    <div class="card product-card h-100 p-3 position-relative">
                        <button class="btn btn-white rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-1 px-2 border-0">
                            <i class="fa-regular fa-heart text-secondary"></i>
                        </button>
                        <div class="product-img-holder mb-3">
                            <img src="https://via.placeholder.com/150" alt="PlayStation 5">
                        </div>
                        <div class="d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small">Accessories</span>
                                <h6 class="fw-bold text-dark mt-1 mb-1">PlayStation 5</h6>
                                <div class="text-warning small mb-2"><i class="fa-solid fa-star"></i> 4.7</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-dark fs-5">$499.99</span>
                                <button class="btn btn-orange btn-sm rounded-pill px-3"><i class="fa-solid fa-cart-plus me-1"></i> Add</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Pagination -->
            <nav class="d-flex justify-content-center mt-5">
                <ul class="pagination pagination-sm">
                    <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item active"><a class="page-link bg-dark border-dark" href="#">1</a></li>
                    <li class="page-item"><a class="page-link text-dark" href="#">2</a></li>
                    <li class="page-item"><a class="page-link text-dark" href="#">3</a></li>
                    <li class="page-item"><a class="page-link text-dark" href="#">Next</a></li>
                </ul>
            </nav>

        </section>
    </div>
</main>