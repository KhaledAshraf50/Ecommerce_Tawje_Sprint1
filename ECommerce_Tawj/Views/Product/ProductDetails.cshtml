@using ECommerce_Tawj.DTOs.ProductsDTOs
@model ProductDetailsDTO
@{
    Layout = "_Layout";
}
@section Styles {
    <style>
        :root {
            --primary-orange: #f05423;
        }

        body {
            background-color: #ffffff;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .btn-orange {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            font-weight: 600;
        }

            .btn-orange:hover {
                background-color: #d84315;
                color: white;
            }

        .thumbnail-img {
            width: 70px;
            height: 70px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            cursor: pointer;
            object-fit: contain;
            padding: 5px;
            transition: all 0.2s ease;
        }

            .thumbnail-img.active, .thumbnail-img:hover {
                border-color: var(--primary-orange);
                border-width: 2px;
            }

        .main-img-box {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 30px;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .main-img-box img {
                max-height: 100%;
                object-fit: contain;
            }
    </style>
}
    <!-- Product Details Section -->
<section class="container my-5">
    <div class="row g-5">
        <!-- Product Gallery (Images) -->
        <div class="col-md-6">
            @{
                var mainImage = Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                             ?? Model.Images.FirstOrDefault()?.ImageUrl
                             ?? "/images/no-image.jpg";
            }

            <!-- Main Image -->
            <div class="main-img-box mb-3">
                <img id="mainImage" src="@mainImage" class="img-fluid" alt="@Model.ProductName" />
            </div>

            <!-- Thumbnails List -->
            @if (Model.Images != null && Model.Images.Count > 1)
            {
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    @foreach (var photo in Model.Images)
                    {
                        <img src="@photo.ImageUrl"
                             class="thumbnail-img @(photo.ImageUrl == mainImage ? "active" : "")"
                             onclick="changeImage(this)"
                             alt="Thumbnail" />
                    }
                </div>
            }
        </div>

        <!-- Product Info & Actions -->
        <div class="col-md-6">
            <span class="badge bg-light text-secondary mb-2 px-3 py-2 border">@Model.CategoryName</span>
            <h2 class="fw-bold text-dark">@Model.ProductName</h2>

            <!-- Rating Stars -->
            <div class="d-flex align-items-center gap-2 my-2">
                <div class="text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Floor(Model.AverageRating))
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                        else if (i - Model.AverageRating < 1)
                        {
                            <i class="fa-solid fa-star-half-stroke"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    }
                </div>
                <span class="text-muted small">(@Model.AverageRating Rating)</span>
            </div>

            <!-- Pricing -->
                <div class="d-flex align-items-center gap-3 my-3">
                    <h3 class="fw-bold text-dark mb-0">$@Model.FinalPrice.ToString("F2")</h3>

                    @if (Model.DiscountPercentage > 0 && Model.DiscountPercentage <= 100)
                    {
                        <span class="text-decoration-line-through text-muted">$@Model.Price.ToString("F2")</span>
                        <span class="badge bg-danger">@Model.DiscountPercentage% OFF</span>
                    }
                </div>

            <!-- Description -->
            <p class="text-muted leading-relaxed">
                @Model.ProductDescription
            </p>

            <hr class="my-4" />
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-orange text-white btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-cart-plus me-1"></i> Add
                        </button>
                    </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
       <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
            $(document).ready(function(){
            $(document).on('click','.btn-favorite',function(e){
                e.preventDefault();
                var buuton = $(this);
                var icon = buuton.find('i');
                var productId = buuton.data('product-id');

                $.ajax({
                    url:'/Favorite/ToggleFavorite',
                    type:'POST',
                    data:{productId:productId},
                    success:function(response){
                        if(response.success){
                            if(response.isFavorite){
                                icon.removeClass('fa-regular text-secondary').addClass('fa-solid text-danger');
                            }
                            else{
                                 icon.removeClass('fa-solid text-danger').addClass('fa-regular text-secondary');
                            }
                        }
                    },
                    error:function(xhr){
                        if(xhr.status == 401){
                            window.location.href = '/Account/Login'
                        }
                    }
                });
            });
        });
    </script>
    <script>
        function changeImage(element) {
            document.getElementById('mainImage').src = element.src;
            document.querySelectorAll('.thumbnail-img').forEach(img => img.classList.remove('active'));
            element.classList.add('active');
        }

     
    </script>
}