@using ECommerce_Tawj.DTOs.ProductsDTOs
@model ProductDetailsDTO
@{
    Layout = "_Layout";
}
@section Styles {
    <style>
        :root {
            --primary-orange: #f05423;
        }

        body {
            background-color: #ffffff;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .btn-orange {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            font-weight: 600;
        }

            .btn-orange:hover {
                background-color: #d84315;
                color: white;
            }

        .thumbnail-img {
            width: 70px;
            height: 70px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            cursor: pointer;
            object-fit: contain;
            padding: 5px;
            transition: all 0.2s ease;
        }

            .thumbnail-img.active, .thumbnail-img:hover {
                border-color: var(--primary-orange);
                border-width: 2px;
            }

        .main-img-box {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 30px;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .main-img-box img {
                max-height: 100%;
                object-fit: contain;
            }
    </style>
}
    <!-- Product Details Section -->
<section class="container my-5">
    <div class="row g-5">
        <!-- Product Gallery (Images) -->
        <div class="col-md-6">
            @{
                var mainImage = Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                             ?? Model.Images.FirstOrDefault()?.ImageUrl
                             ?? "/images/no-image.jpg";
            }

            <!-- Main Image -->
            <div class="main-img-box mb-3">
                <img id="mainImage" src="@mainImage" class="img-fluid" alt="@Model.ProductName" />
            </div>

            <!-- Thumbnails List -->
            @if (Model.Images != null && Model.Images.Count > 1)
            {
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    @foreach (var photo in Model.Images)
                    {
                        <img src="@photo.ImageUrl"
                             class="thumbnail-img @(photo.ImageUrl == mainImage ? "active" : "")"
                             onclick="changeImage(this)"
                             alt="Thumbnail" />
                    }
                </div>
            }
        </div>

        <!-- Product Info & Actions -->
        <div class="col-md-6">
            <span class="badge bg-light text-secondary mb-2 px-3 py-2 border">@Model.CategoryName</span>
            <h2 class="fw-bold text-dark">@Model.ProductName</h2>

            <!-- Rating Stars -->
            <div class="d-flex align-items-center gap-2 my-2">
                <div class="text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Floor(Model.AverageRating))
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                        else if (i - Model.AverageRating < 1)
                        {
                            <i class="fa-solid fa-star-half-stroke"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    }
                </div>
                <span class="text-muted small">(@Model.AverageRating Rating)</span>
            </div>

            <!-- Pricing -->
            <div class="d-flex align-items-center gap-3 my-3">
                <h3 class="fw-bold text-dark mb-0">$@Model.finalProce.ToString("F2")</h3>
                @if (Model.DiscountPercentage > 0)
                {
                    <span class="text-decoration-line-through text-muted">$@Model.Price.ToString("F2")</span>
                    <span class="badge bg-danger">@Model.DiscountPercentage% OFF</span>
                }
            </div>

            <!-- Description -->
            <p class="text-muted leading-relaxed">
                @Model.ProductDescription
            </p>

            <hr class="my-4" />

            <!-- Quantity & Actions -->
            <div class="d-flex align-items-center gap-3">
                <div class="input-group" style="width: 130px">
                    <button class="btn btn-outline-secondary" type="button" onclick="decrementQty()">-</button>
                    <input type="text" id="quantityInput" class="form-control text-center" value="1" readonly />
                    <button class="btn btn-outline-secondary" type="button" onclick="incrementQty()">+</button>
                </div>

                <button class="btn btn-orange px-4 py-2 rounded-3">
                    <i class="fa-solid fa-cart-plus me-2"></i>Add to Cart
                </button>

                <button class="btn btn-outline-secondary p-2 px-3 rounded-3 btn-favorite" data-product-id="@Model.Id">
                    <i class="fa-regular fa-heart"></i>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function changeImage(element) {
            document.getElementById('mainImage').src = element.src;
            document.querySelectorAll('.thumbnail-img').forEach(img => img.classList.remove('active'));
            element.classList.add('active');
        }

        function incrementQty() {
            let input = document.getElementById('quantityInput');
            input.value = parseInt(input.value) + 1;
        }

        function decrementQty() {
            let input = document.getElementById('quantityInput');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }
    </script>
}