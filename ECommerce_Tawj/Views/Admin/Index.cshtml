@{
    Layout = "_AdminLayout";
}
<main class="flex-grow-1 p-4 p-md-5">
    <h4 class="fw-bold text-dark mb-4">Dashboard Overview</h4>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Sales</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">$24,500</h3>
                    </div>
                    <div class="stat-icon bg-light text-success">
                        <i class="fa-solid fa-dollar-sign"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Orders</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">1,240</h3>
                    </div>
                    <div class="stat-icon bg-light text-primary">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Products</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">86</h3>
                    </div>
                    <div class="stat-icon bg-light text-warning">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Active Users</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">320</h3>
                    </div>
                    <div class="stat-icon bg-light text-danger">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3">Recent Orders</h5>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#ORD-8821</td>
                        <td>John Doe</td>
                        <td>Jul 28, 2026</td>
                        <td><span class="badge bg-success">Completed</span></td>
                        <td class="fw-bold">$499.99</td>
                    </tr>
                    <tr>
                        <td>#ORD-8820</td>
                        <td>Sarah Ali</td>
                        <td>Jul 27, 2026</td>
                        <td>
                            <span class="badge bg-warning text-dark">Pending</span>
                        </td>
                        <td class="fw-bold">$1,299.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>