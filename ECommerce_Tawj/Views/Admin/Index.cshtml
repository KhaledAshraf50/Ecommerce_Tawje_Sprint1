@using ECommerce_Tawj.DTOs.OrdersDTOs
@model DashboardDTO

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<main class="flex-grow-1 p-4 p-md-5">
    <h4 class="fw-bold text-dark mb-4">Dashboard Overview</h4>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Sales -->
        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Sales</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">$@Model.TotalSales.ToString("F2")</h3>
                    </div>
                    <div class="stat-icon bg-light text-success p-3 rounded-circle">
                        <i class="fa-solid fa-dollar-sign fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Orders -->
        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Orders</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOrders</h3>
                    </div>
                    <div class="stat-icon bg-light text-primary p-3 rounded-circle">
                        <i class="fa-solid fa-bag-shopping fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Products -->
        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Products</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalProducts</h3>
                    </div>
                    <div class="stat-icon bg-light text-warning p-3 rounded-circle">
                        <i class="fa-solid fa-box-open fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Users -->
        <div class="col-md-3">
            <div class="card stat-card p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Active Users</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.ActiveUsers</h3>
                    </div>
                    <div class="stat-icon bg-light text-danger p-3 rounded-circle">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3">Recent Orders</h5>
        <div class="table-responsive">
            <table class="table align-middle border-0 mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td class="fw-bold">#ORD-@order.Id</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@order.Status</span>
                            </td>
                            <td class="fw-bold text-dark">$@order.TotalAmount.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>