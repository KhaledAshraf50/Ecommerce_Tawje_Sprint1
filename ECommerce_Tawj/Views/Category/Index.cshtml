@using ECommerce_Tawj.DTOs.CategoryDTOs
@model CategoryIndexDTO
@{

    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";
}
@section Styles{
    <link href="~/css/Categories.css" rel="stylesheet" />
}
<main class="flex-grow-1 p-4 p-md-5">
    <h4 class="fw-bold text-dark mb-4">Category Management</h4>

    <div class="row g-4">
        <!-- Add Category Form -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <h6 class="fw-bold mb-3">Add New Category</h6>
                <form asp-action="Create" method="post" asp-controller="Category">
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Category Name</label>
                        <input type="text"
                               class="form-control"
                               placeholder="e.g. Headphones" 
                               asp-for="NewCategory.Name"
                               />
                        <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Description</label>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Category details..."
                                  asp-for="NewCategory.Description"
                                  ></textarea>
                        <span asp-validation-for="NewCategory.Description" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-orange w-100 rounded-3">
                        Save Category
                    </button>
                </form>
            </div>
        </div>

        <!-- Categories List -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <h6 class="fw-bold mb-3">Existing Categories</h6>
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Category Name</th>
                            <th>Products Count</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td class="fw-medium">@cat.Name</td>
                                    <td>@cat.ProductsCount Products</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary me-1">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No categories found yet. Add your first category!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>