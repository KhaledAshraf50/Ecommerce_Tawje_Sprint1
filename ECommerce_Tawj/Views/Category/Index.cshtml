@using ECommerce_Tawj.DTOs.CategoryDTOs
@model CategoryIndexDTO
@{
    ViewData["Title"] = "Category Management";
    Layout = "_AdminLayout";
}
@section Styles {
    <link href="~/css/Categories.css" rel="stylesheet" />
}

<main class="flex-grow-1 p-4 p-md-5">
    <h4 class="fw-bold text-dark mb-4">Category Management</h4>

    <div class="row g-4">
        <!-- Add Category Form -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <h6 class="fw-bold mb-3">Add New Category</h6>
                <form asp-action="Create" method="post" asp-controller="Category">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Category Name</label>
                        <input type="text" class="form-control" placeholder="e.g. Headphones" asp-for="NewCategory.Name" />
                        <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Description</label>
                        <textarea class="form-control" rows="3" placeholder="Category details..." asp-for="NewCategory.Description"></textarea>
                        <span asp-validation-for="NewCategory.Description" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-orange w-100 rounded-3">Save Category</button>
                </form>
            </div>
        </div>

        <!-- Categories List -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <h6 class="fw-bold mb-3">Existing Categories</h6>
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Category Name</th>
                            <th>Products Count</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td class="fw-medium">@cat.Name</td>
                                    <td>@cat.ProductsCount Products</td>
                                    <td class="text-end">
                                        <!-- Edit Modal Trigger -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editModal-@cat.Id">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>

                                        <!-- Delete Form -->
                                        <form asp-controller="Category" asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No categories found yet. Add your first category!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<!-- Edit Category Modals (مكانه الصحيح خارج الجدول والخلايا) -->
@if (Model.Categories != null && Model.Categories.Any())
{
    @foreach (var cat in Model.Categories)
    {
        <div class="modal fade text-start" id="editModal-@cat.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Edit Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-controller="Category" asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <input type="hidden" name="Id" value="@cat.Id" />
                            <div class="mb-3">
                                <label class="form-label text-secondary small fw-bold">Category Name</label>
                                <input type="text" name="Name" class="form-control" value="@cat.Name" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-secondary small fw-bold">Description</label>
                                <textarea name="Description" class="form-control" rows="3">@cat.Description</textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-orange rounded-3">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.btn-delete').forEach(button => {
        button.addEventListener('click', function () {
        const form = this.closest('.delete-form');
        Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
        if (result.isConfirmed) {
        form.submit();
        }
        });
        });
        });
    </script>
}